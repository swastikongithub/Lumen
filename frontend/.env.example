# Copy to frontend/.env for local development. Never commit .env.
# Vite bakes VITE_* values into the build, so set this before `npm run build`.

# Base URL of the Lumen API, without a trailing slash and without /api/v1.
# Local backend: uvicorn on port 8000. Release builds (web and Android): the Cloud Run URL.
VITE_API_URL=http://localhost:8000
