# Copy to backend/.env for local development. Never commit .env.
# Every setting in app/config.py is listed here. Defaults match docker-compose.yml.

LOG_LEVEL=INFO

# Postgres (async driver). docker-compose maps Postgres to host port 5433.
# In production this is the Neon connection string, using the postgresql+asyncpg:// scheme.
DATABASE_URL=postgresql+asyncpg://lumen:lumen@localhost:5433/lumen

# Qdrant. QDRANT_API_KEY is only needed for Qdrant Cloud; leave it empty locally.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kb_chunks

# Embedding model (FastEmbed) shared by ingestion and the API; EMBED_DIM must match it.
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
EMBED_BATCH_SIZE=64

# Ingestion (`uv run lumen ...`). Paths default to data/sources.yaml and data/raw/
# at the repository root; set them only to point somewhere else.
SOURCES_PATH=
RAW_DIR=
CHUNK_MAX_TOKENS=384
# Reject a document when more than this share of its pages has no text.
MAX_EMPTY_PAGE_RATIO=0.2
# robots.txt rules are matched against the product token before "/".
FETCH_USER_AGENT=LumenBot/0.1
FETCH_TIMEOUT_SECONDS=60
# Seconds to wait between two downloads from the same host.
FETCH_DELAY_SECONDS=1.0

# Retrieval (SPEC §9 step 4): dense and BM25 candidates, fused with RRF.
RETRIEVE_DENSE_LIMIT=30
RETRIEVE_SPARSE_LIMIT=30
RETRIEVE_FUSED_LIMIT=20
# Document groups answers may come from (SPEC §3.2). Drop "ums" to leave out UMS-linked policies.
RETRIEVAL_ORIGINS=lpu.in,ums

# Re-ranking and abstention (SPEC §9 steps 5-6).
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-12-v2
RERANK_TOP_N=5
# τ: below this best cross-encoder score (a raw logit) Lumen abstains without calling the LLM.
# Starting value only; Phase 3 tunes it on the golden set.
ABSTAIN_THRESHOLD=0.0
# Closest sources shown with an abstained answer.
ABSTAIN_SOURCES=3

# Generation (SPEC §9 step 7, §9.2). Model ids use LiteLLM's "<provider>/<model>" form.
# A model is used only when its provider's key is set; the chain is primary -> secondary -> fallback.
# Check the current ids and limits in the Groq console and Google AI Studio before deploying.
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_PRIMARY_MODEL=groq/openai/gpt-oss-120b
LLM_SECONDARY_MODEL=groq/openai/gpt-oss-20b
LLM_FALLBACK_MODEL=gemini/gemini-3.5-flash
# Reasoning models (gpt-oss) spend part of the output budget thinking; "low" keeps that short.
# Leave empty to send no reasoning setting. Ignored by models without reasoning.
LLM_REASONING_EFFORT=low
CONTEXT_MAX_TOKENS=2000
ANSWER_MAX_TOKENS=400
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
# A rate-limited model is skipped for this long; also the retry_after sent when every model is busy.
LLM_COOLDOWN_SECONDS=60

# Comma-separated browser origins allowed by CORS.
# http://localhost:5173 = Vite dev server, https://localhost = Capacitor Android WebView.
# Add the Cloudflare Pages domain in production.
CORS_ORIGINS=http://localhost:5173,https://localhost

# Returned by GET /api/v1/meta. Android builds below MIN_APP_VERSION show "Update required".
MIN_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0
APP_NOTICE=

# Seconds each /ready dependency check may take.
READY_TIMEOUT_SECONDS=2.0

# Test suite only: database the integration tests use (must end in _test; tests drop its tables).
TEST_DATABASE_URL=postgresql+asyncpg://lumen:lumen@localhost:5433/lumen_test
