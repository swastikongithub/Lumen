# Copy to backend/.env for local development. Never commit .env.
# Every setting in app/config.py is listed here. Defaults match docker-compose.yml.

LOG_LEVEL=INFO

# Postgres (async driver). docker-compose maps Postgres to host port 5433.
# In production this is the Neon connection string, using the postgresql+asyncpg:// scheme.
DATABASE_URL=postgresql+asyncpg://lumen:lumen@localhost:5433/lumen

# Qdrant. QDRANT_API_KEY is only needed for Qdrant Cloud; leave it empty locally.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Comma-separated browser origins allowed by CORS.
# http://localhost:5173 = Vite dev server, https://localhost = Capacitor Android WebView.
# Add the Cloudflare Pages domain in production.
CORS_ORIGINS=http://localhost:5173,https://localhost

# Returned by GET /api/v1/meta. Android builds below MIN_APP_VERSION show "Update required".
MIN_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0
APP_NOTICE=

# Seconds each /ready dependency check may take.
READY_TIMEOUT_SECONDS=2.0

# Test suite only: database the integration tests use (must end in _test; tests drop its tables).
TEST_DATABASE_URL=postgresql+asyncpg://lumen:lumen@localhost:5433/lumen_test
